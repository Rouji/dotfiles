[Unit]
Description=Save current Sway tree snapshot (swaytreesave)
Documentation=https://github.com/fabienjuif/swaytreesave
PartOf=sway-session.target
After=sway-session.target
Requisite=sway-session.target

[Service]
Type=oneshot
# Exit 0 (not fail) when sway isn't running; otherwise find the live IPC
# socket and save. SWAYSOCK is set explicitly because socket path carries
# the compositor PID and changes across logins.
ExecStart=/bin/sh -c 'rt=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}; sock=$(find "$rt" -maxdepth 1 -name "sway-ipc.*.sock" 2>/dev/null | head -n1); [ -n "$sock" ] || exit 0; SWAYSOCK="$sock" exec /usr/bin/swaytreesave save'
